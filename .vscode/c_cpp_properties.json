{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/cmsis",
                "${workspaceFolder}/hal",
                "${workspaceFolder}/inc",
                "${workspaceFolder}/cmsis-dap/inc",
            ],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-clang-x64",
            "defines": [
                "STM32F722xx",

                "ENABLE_USB_FS",
                "ENABLE_USB_HS",
                // "ENABLE_USB_HS_MODE_FS",
                "ENABLE_USB_HS_MODE_ULPI",

                // "BOOTLOADER",
                // "BOOTLOADER_USB",

                "USB_INTERFACE_CMSIS_DAP",

                "ENABLE_DEBUGGING",
                "ENABLE_LOGGING",
            ]
        }
    ],
    "version": 4
}
